{
  "name": "insurance-damage-camera",
  "version": "1.0.0",
  "description": "Insurance damage report photo capture feature",
  "main": "index.js",
  "scripts": {
    "test": "jest --ci --reporters=default --reporters=jest-junit",
    "test:coverage": "jest --coverage"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ],
    "moduleNameMapper": {
      "^react-native$": "<rootDir>/src/__mocks__/react-native.ts",
      "^react-native-image-picker$": "<rootDir>/src/__mocks__/react-native-image-picker.ts",
      "^react-native-fs$": "<rootDir>/src/__mocks__/react-native-fs.ts",
      "^react-native-aes-crypto$": "<rootDir>/src/__mocks__/react-native-aes-crypto.ts",
      "^@react-native-community/netinfo$": "<rootDir>/src/__mocks__/@react-native-community/netinfo.ts",
      "^expo-camera$": "<rootDir>/src/__mocks__/expo-camera.ts"
    },
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.ts",
      "src/**/*.tsx",
      "!src/__mocks__/**"
    ]
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.73.0",
    "react-native-image-picker": "^7.0.0",
    "react-native-fs": "^2.20.0",
    "react-native-aes-crypto": "^2.1.1",
    "@react-native-community/netinfo": "^11.0.0",
    "expo-camera": "^14.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.73.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  }
}
