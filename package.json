{
  "name": "insurance-photo-upload",
  "version": "1.0.0",
  "description": "Automatische Komprimierung und verschlüsselter Upload für Schadensdokumentation",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "vitest run --reporter=junit --outputFile=.agentsphere/reports/junit.xml",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "lint": "eslint src tests --ext .ts"
  },
  "dependencies": {
    "sharp": "^0.33.4",
    "uuid": "^9.0.1",
    "node-forge": "^1.3.1",
    "form-data": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/uuid": "^9.0.8",
    "@types/node-forge": "^1.3.11",
    "@types/form-data": "^2.5.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0",
    "nock": "^13.5.4",
    "@types/nock": "^11.1.0"
  }
}
