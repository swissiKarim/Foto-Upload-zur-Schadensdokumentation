{
  "name": "insurance-photo-upload",
  "version": "1.0.0",
  "description": "Offline photo upload queue for insurance damage reports",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "jest --forceExit --runInBand --reporters=default --reporters=jest-junit 2>&1",
    "test:coverage": "jest --coverage --forceExit --runInBand"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "@types/node-fetch": "^2.6.11",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.ts"],
    "reporters": [
      "default",
      ["jest-junit", {
        "outputDirectory": ".agentsphere/reports",
        "outputName": "junit.xml"
      }]
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": ["src/**/*.ts"]
  }
}
